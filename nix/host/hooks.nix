# Lifecycle hooks for the tartarus CLI.
#
# At rebuild time this renders `~/.config/tartarus/hooks.toml`, the file the CLI
# (`src/tartarus/hooks.py`) reads around every lifecycle operation:
#
#   * the host-wide hooks from `tartarus.hooks`;
#   * the per-guest hooks from `tartarus.guests.<name>.hooks`, with
#     `guests = ["<name>"]` and `kinds = ["<kind>"]` forced so a per-guest hook
#     only ever fires for that guest's own instances.
#
# Written through home-manager for the same reason as `config.nix`: that is the
# mechanism that lands a file in the user's home on both NixOS and nix-darwin.
# The file is deliberately separate from `config.toml` and carries its own
# `schema = 1`: `config.toml` stays a pure description of guests and paths
# (schema 2), while hooks are behaviour and evolve independently.
#
# TOML is rendered by hand from the primitives in `nix/lib/toml.nix` (shared
# with `config.nix`); the output must match `src/tartarus/hooks.py` exactly.
{
  config,
  lib,
  options,
  ...
} @ args: let
  inherit
    (lib)
    concatMap
    concatStringsSep
    mkIf
    mkOption
    optionalString
    sort
    ;
  tomlLib = import ../lib/toml.nix {inherit lib;};
  inherit (tomlLib) tArr tFloat tInt tStr;

  # Read from the raw module args (specialArgs); a defaulted formal would be
  # ignored by this nixpkgs and shadow `config`.
  username = args.username or "user";

  cfg = config.tartarus;
  instances = config.tartarus.instances;
  hasGuests = instances.vm.enabledNames != [] || instances.container.enabledNames != [];

  # Explicit ordering: attrsets have no stable order, and the CLI runs hooks in
  # file order, so the event/phase matrix is spelled out. Host-wide entries come
  # first, then per-guest ones (sorted by guest name).
  events = ["create" "start" "stop" "remove" "build"];
  phases = ["before" "after"];

  # Plain records only (`instances.guests`), never `config.tartarus.guests`:
  # forcing the guest submodule here trips nixpkgs' `_module.args` recursion
  # (see nix/host/instances.nix). Disabled guests are absent by construction.
  guestNames = sort (a: b: a < b) (builtins.attrNames instances.guests);

  hostHooks = event: phase: cfg.hooks.${event}.${phase};
  guestHooks = name: event: phase: instances.guests.${name}.hooks.${event}.${phase};

  # A per-guest entry is forced onto its own guest and kind; whatever `guests`
  # or `kinds` the user wrote in that entry is ignored.
  forceGuest = name: h:
    h
    // {
      guests = [name];
      kinds = [instances.guests.${name}.kind];
    };

  # One `[[hooks]]` block, without trailing blank lines: the separator between
  # blocks is added by `blocksFor` so the last block can end the file cleanly.
  hookBlock = event: phase: h: ''
    [[hooks]]
    event = ${tStr event}
    phase = ${tStr phase}
    command = ${tStr h.command}
    guests = ${tArr h.guests}
    kinds = ${tArr h.kinds}
    timeout = ${tFloat (1.0 * h.timeout)}
    retries = ${tInt h.retries}
    retry_delay = ${tFloat h.retryDelay}
    on_failure = ${tStr h.onFailure}
    ${optionalString (h.description != null) "description = ${tStr h.description}\n"}'';

  # Every hook for one event/phase, host-wide first then per guest.
  blocksFor = event: phase:
    map (hookBlock event phase) (hostHooks event phase)
    ++ concatMap (
      name: map (hookBlock event phase) (map (forceGuest name) (guestHooks name event phase))
    )
    guestNames;

  # Flattened over the explicit event/phase matrix, so the file order is
  # deterministic. Nix's `''` keeps a trailing newline inside `hookBlock`, so
  # joining with "\n" yields exactly one blank line between blocks and the
  # final block already ends the file with a newline.
  body = concatStringsSep "\n" (concatMap (event: concatMap (blocksFor event) phases) events);

  # Nix keeps a single trailing newline inside `''` (the closing delimiter's
  # line is dropped), so `header` already ends in "\n" and the body only
  # prefixes a blank separator line.
  header = ''
    # Generated by tartarus (nix/host/hooks.nix). Do not edit.
    schema = 1
  '';
  toml = header + optionalString (body != "") "\n${body}";
in {
  config = mkIf (hasGuests && options ? home-manager) {
    home-manager.users.${username}.home.file.".config/tartarus/hooks.toml".text = toml;
  };
}
